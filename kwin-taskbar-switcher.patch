+void TabBoxTest::testTaskbarDefaultMode()
+{
+#if !KWIN_BUILD_GLOBALSHORTCUTS
+    QSKIP("Can't test shortcuts without shortcuts");
+#endif
+    auto c1 = createTaskbarWindow();
+    auto c2 = createTaskbarWindow();
+    auto c3 = createTaskbarWindow();
+    QVERIFY(c1 && c2 && c3);
+    QVERIFY(taskbarCall(QStringLiteral("setTaskbarWindowOrder"), 7,
+                        {c1->internalId().toString(), c2->internalId().toString(), c3->internalId().toString()}));
+    workspace()->activateWindow(c2);
+    workspace()->activateWindow(c1);
+    auto box = workspace()->tabbox();
+    Test::keyboardKeyPressed(KEY_LEFTALT, m_timestamp++);
+    tap(KEY_TAB);
+    QTRY_VERIFY(box->isGrabbed());
+    QCOMPARE(box->currentClientList(), QList<Window *>({c1, c2, c3}));
+    QCOMPARE(box->currentClient(), c2);
+    tap(KEY_TAB);
+    QCOMPARE(box->currentClient(), c3);
+    tap(KEY_TAB);
+    QCOMPARE(box->currentClient(), c1); // Ordinary Alt+Tab still wraps.
+    Test::keyboardKeyReleased(KEY_LEFTALT, m_timestamp++);
+    QCOMPARE(workspace()->activeWindow(), c1);
+    workspace()->activateWindow(c3);
+    Test::keyboardKeyPressed(KEY_LEFTALT, m_timestamp++);
+    tap(KEY_TAB);
+    QTRY_VERIFY(box->isGrabbed());
+    QCOMPARE(box->currentClient(), c1); // MRU, not the preceding taskbar entry.
+    Test::keyboardKeyReleased(KEY_LEFTALT, m_timestamp++);
+    QCOMPARE(workspace()->activeWindow(), c1);
+}
