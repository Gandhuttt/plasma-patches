+    auto c3 = createTaskbarWindow();
+    QVERIFY(c1 && c2 && c3);
+    auto box = workspace()->tabbox();
+    const QStringList order{c1->internalId().toString(), c2->internalId().toString(), c3->internalId().toString()};
+    QVERIFY(taskbarCall(QStringLiteral("setTaskbarWindowOrder"), 7, order));
+    // Deliberately make MRU differ from the published order.
+    workspace()->activateWindow(c2);
+    workspace()->activateWindow(c1);
+    auto alternative = kwinApp()->config()->group(QStringLiteral("TabBoxAlternative"));
+    alternative.writeEntry("ShowTabBox", true);
+    alternative.sync();
+    workspace()->slotReconfigure();
+
+    Test::keyboardKeyPressed(KEY_LEFTMETA, m_timestamp++);
+    tap(KEY_L);
+    QTRY_VERIFY(box->isGrabbed());
+    QTRY_VERIFY(box->isShown());
+    QCOMPARE(box->currentClientList(), QList<Window *>({c1, c2, c3}));
+    QCOMPARE(box->currentClient(), c2);
+    const auto visibleSwitcher = []() -> QQuickWindow * {
+        for (QWindow *window : QGuiApplication::allWindows()) {
+            if (auto quick = qobject_cast<QQuickWindow *>(window); quick && quick->isVisible() && quick->isExposed()) {
+                return quick;
+            }
+        }
+        return nullptr;
+    };
+    QTRY_VERIFY2(visibleSwitcher(), "The native thumbnail_grid QML switcher must create an exposed QQuickWindow");
+    QPointer<QQuickWindow> preview = visibleSwitcher();
+    QVERIFY(preview->width() > 0 && preview->height() > 0);
+    QCOMPARE(workspace()->activeWindow(), c1); // Holding Win only previews.
+    tap(KEY_L);
+    QCOMPARE(box->currentClient(), c3);
+    tap(KEY_L);
+    tap(KEY_L); // Separate presses, not merely auto-repeat, must stay bounded.
+    QCOMPARE(box->currentClient(), c3);
+    tap(KEY_H);
+    QCOMPARE(box->currentClient(), c2);
+    tap(KEY_H);
+    tap(KEY_H);
+    QCOMPARE(box->currentClient(), c1);
+    tap(KEY_L);
+    Test::keyboardKeyReleased(KEY_LEFTMETA, m_timestamp++);
+    QTRY_VERIFY(!box->isGrabbed());
+    QCOMPARE(workspace()->activeWindow(), c2);
+    QTRY_VERIFY(!preview || !preview->isVisible());
+
+    Test::keyboardKeyPressed(KEY_LEFTMETA, m_timestamp++);
+    tap(KEY_L);
+    QTRY_VERIFY(box->isGrabbed());
+    QCOMPARE(box->currentClient(), c3);
+    tap(KEY_ESC);
+    QVERIFY(!box->isGrabbed());
+    Test::keyboardKeyReleased(KEY_LEFTMETA, m_timestamp++);
+    QCOMPARE(workspace()->activeWindow(), c2);
+}
