+void TabBox::setTaskbarWindowOrder(uint sourceId, const QStringList &windowIds)
+{
+    QList<QUuid> order;
+    order.reserve(windowIds.size());
+    for (const QString &id : windowIds) {
+        const QUuid uuid(id);
+        if (uuid.isNull() || order.contains(uuid)) {
+            continue;
+        }
+        Window *window = workspace()->findWindow(uuid);
+        if (window && !window->isDeleted() && window->isClient()) {
+            order.append(uuid);
+        }
+    }
+    // An empty snapshot is authoritative, unlike the absence of a publisher.
+    m_taskbarWindowOrders.insert(sourceId, order);
+    refreshTaskbarOrder();
+}
+
+void TabBox::removeTaskbarWindowOrder(uint sourceId)
+{
+    if (m_taskbarWindowOrders.remove(sourceId)) {
+        refreshTaskbarOrder();
+    }
+}
+
+QList<Window *> TabBox::taskbarOrder() const
+{
+    if (m_taskbarWindowOrders.isEmpty()) {
+        auto order = workspace()->windows();
+        order.removeIf([](Window *window) {
+            return !window->isClient() || window->isDeleted();
+        });
+        return order;
+    }
+    QList<Window *> order;
+    order.reserve(m_taskbarWindowOrders.first().size());
+    for (const QUuid &uuid : m_taskbarWindowOrders.first()) {
+        Window *window = workspace()->findWindow(uuid);
+        if (window && !window->isDeleted() && window->isClient()) {
+            order.append(window);
+        }
+    }
+    return order;
+}
+
