+bool TabBoxTest::taskbarCall(const QString &method, uint sourceId, const QStringList &ids)
+{
+    auto message = QDBusMessage::createMethodCall(QStringLiteral("org.kde.KWin"), QStringLiteral("/KWin"),
+                                                 QStringLiteral("org.kde.KWin"), method);
+    message << sourceId;
+    if (method == QLatin1String("setTaskbarWindowOrder")) {
+        message << ids;
+    }
+    QDBusPendingCallWatcher watcher(QDBusConnection::sessionBus().asyncCall(message));
+    QSignalSpy finished(&watcher, &QDBusPendingCallWatcher::finished);
+    if (!watcher.isFinished() && !finished.wait()) {
+        return false;
+    }
+    if (watcher.isError()) {
+        qWarning() << watcher.error();
+        return false;
+    }
+    return true;
+}
