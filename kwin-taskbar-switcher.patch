+void TabBoxTest::testTaskbarDesktopFilter()
+{
+#if !KWIN_BUILD_GLOBALSHORTCUTS
+    QSKIP("Can't test shortcuts without shortcuts");
+#endif
+    auto c1 = createTaskbarWindow();
+    auto c2 = createTaskbarWindow();
+    auto c3 = createTaskbarWindow();
+    QVERIFY(c1 && c2 && c3);
+    auto desktops = VirtualDesktopManager::self();
+    desktops->setCount(2);
+    c3->setDesktops({desktops->desktops().at(1)});
+    auto alternative = kwinApp()->config()->group(QStringLiteral("TabBoxAlternative"));
+    alternative.writeEntry("DesktopMode", 1); // OnlyCurrentDesktopClients
+    alternative.sync();
+    workspace()->slotReconfigure();
+    QVERIFY(taskbarCall(QStringLiteral("setTaskbarWindowOrder"), 7,
+                        {c1->internalId().toString(), c2->internalId().toString(), c3->internalId().toString()}));
+    workspace()->activateWindow(c1);
+    auto box = workspace()->tabbox();
+    Test::keyboardKeyPressed(KEY_LEFTMETA, m_timestamp++);
+    tap(KEY_L);
+    QTRY_VERIFY(box->isGrabbed());
+    QCOMPARE(box->currentClientList(), QList<Window *>({c1, c2}));
+    QCOMPARE(box->currentClient(), c2);
+    desktops->setCurrent(2);
+    QTRY_COMPARE(box->currentClientList(), QList<Window *>({c3}));
+    QCOMPARE(box->currentClient(), c3);
+    // Simulate the filtered TasksModel publication arriving after desktop change.
+    QVERIFY(taskbarCall(QStringLiteral("setTaskbarWindowOrder"), 7, {c3->internalId().toString()}));
+    QCOMPARE(box->currentClient(), c3);
+    Test::keyboardKeyReleased(KEY_LEFTMETA, m_timestamp++);
+    QCOMPARE(workspace()->activeWindow(), c3);
+}
