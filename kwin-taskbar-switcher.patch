+    tap(KEY_L);
+    QCOMPARE(box->currentClient(), c2);
+    QVERIFY(taskbarCall(QStringLiteral("setTaskbarWindowOrder"), 7, {id3, id1}));
+    QCOMPARE(box->currentClient(), c1); // Removed selection clamps to a live row.
+    m_taskbarWindows[0].shell.reset();
+    m_taskbarWindows[0].surface.reset();
+    QVERIFY(Test::waitForWindowClosed(c1));
+    m_taskbarWindows[0].window = nullptr;
+    QTRY_COMPARE(box->currentClientList(), QList<Window *>({c3}));
+    QCOMPARE(box->currentClient(), c3);
+    // A subsequent snapshot with the closed UUID cannot resurrect it.
+    QVERIFY(taskbarCall(QStringLiteral("setTaskbarWindowOrder"), 7, {id1, id2, id3}));
+    QCOMPARE(box->currentClientList(), QList<Window *>({c2, c3}));
+    QCOMPARE(box->currentClient(), c3);
+    QVERIFY(taskbarCall(QStringLiteral("setTaskbarWindowOrder"), 7, {}));
+    QVERIFY(box->currentClientList().isEmpty());
+    QVERIFY(!box->currentClient());
+    Test::keyboardKeyReleased(KEY_LEFTMETA, m_timestamp++);
+    QVERIFY(!box->isGrabbed());
+    QVERIFY(workspace()->activeWindow() != c1);
+}
+
+void TabBoxTest::testTaskbarProviders()
+{
+#if !KWIN_BUILD_GLOBALSHORTCUTS
+    QSKIP("Can't test shortcuts without shortcuts");
+#endif
+    auto c1 = createTaskbarWindow();
+    auto c2 = createTaskbarWindow();
+    auto c3 = createTaskbarWindow();
+    QVERIFY(c1 && c2 && c3);
+    const QString id1 = c1->internalId().toString();
+    const QString id2 = c2->internalId().toString();
+    const QString id3 = c3->internalId().toString();
+    auto box = workspace()->tabbox();
+    // Start without a publisher: creation order is stable even after refocusing.
+    workspace()->activateWindow(c2);
+    workspace()->activateWindow(c1);
+    Test::keyboardKeyPressed(KEY_LEFTMETA, m_timestamp++);
+    tap(KEY_L);
+    QTRY_VERIFY(box->isGrabbed());
+    QCOMPARE(box->currentClientList(), QList<Window *>({c1, c2, c3}));
+    QCOMPARE(box->currentClient(), c2);
+    tap(KEY_ESC);
+    Test::keyboardKeyReleased(KEY_LEFTMETA, m_timestamp++);
+
+    QDBusServiceWatcher serviceWatcher(QStringLiteral("org.kde.plasmashell"), QDBusConnection::sessionBus(),
+                                       QDBusServiceWatcher::WatchForOwnerChange);
+    QSignalSpy ownerChanged(&serviceWatcher, &QDBusServiceWatcher::serviceOwnerChanged);
+    auto publisher = QDBusConnection::connectToBus(QDBusConnection::SessionBus, QStringLiteral("taskbar-publisher"));
+    QVERIFY(publisher.registerService(QStringLiteral("org.kde.plasmashell")));
+    QTRY_COMPARE(ownerChanged.count(), 1);
+    c2->setSkipSwitcher(true);
+    QVERIFY(taskbarCall(QStringLiteral("setTaskbarWindowOrder"), 19, {id3}));
+    QVERIFY(taskbarCall(QStringLiteral("setTaskbarWindowOrder"), 7,
+                        {QStringLiteral("invalid"), QUuid::createUuid().toString(), id2, id1, c1->internalId().toString(QUuid::WithoutBraces), id1}));
+    Test::keyboardKeyPressed(KEY_LEFTMETA, m_timestamp++);
+    tap(KEY_L);
+    QTRY_VERIFY(box->isGrabbed());
+    QCOMPARE(box->currentClientList(), QList<Window *>({c1}));
+    QCOMPARE(box->currentClient(), c1);
+    QVERIFY(taskbarCall(QStringLiteral("setTaskbarWindowOrder"), 7, {}));
+    QVERIFY(box->currentClientList().isEmpty()); // Lowest source's empty list wins.
+    QVERIFY(!box->currentClient());
+    QVERIFY(taskbarCall(QStringLiteral("removeTaskbarWindowOrder"), 7));
+    QCOMPARE(box->currentClientList(), QList<Window *>({c3}));
+    QCOMPARE(box->currentClient(), c3);
+    c2->setSkipSwitcher(false);
+    QVERIFY(publisher.unregisterService(QStringLiteral("org.kde.plasmashell")));
+    QTRY_COMPARE(ownerChanged.count(), 2);
+    QTRY_COMPARE(box->currentClientList(), QList<Window *>({c1, c2, c3}));
+    QCOMPARE(box->currentClient(), c3);
+    QDBusConnection::disconnectFromBus(QStringLiteral("taskbar-publisher"));
+    tap(KEY_ESC);
+    Test::keyboardKeyReleased(KEY_LEFTMETA, m_timestamp++);
+
+    // When active isn't published, entry chooses the edge in either direction.
+    QVERIFY(taskbarCall(QStringLiteral("setTaskbarWindowOrder"), 7, {id2, id3}));
+    for (const auto &[key, expected] : {std::pair<uint, Window *>(KEY_L, c2), {KEY_H, c3}}) {
+        workspace()->activateWindow(c1);
+        Test::keyboardKeyPressed(KEY_LEFTMETA, m_timestamp++);
+        tap(key);
+        QTRY_VERIFY(box->isGrabbed());
+        QCOMPARE(box->currentClient(), expected);
+        Test::keyboardKeyReleased(KEY_LEFTMETA, m_timestamp++);
+        QCOMPARE(workspace()->activeWindow(), expected);
+    }
+}
