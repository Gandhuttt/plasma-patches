+void GlobalShortcutsTest::testDefaultTouchpadGestures()
+{
+    QFETCH(int, fingers);
+    QFETCH(QPointF, delta);
+    QFETCH(uint, rows);
+    QFETCH(uint, desktop);
+    auto desktops = VirtualDesktopManager::self();
+    desktops->setCount(3);
+    desktops->setRows(rows);
+    desktops->setNavigationWrappingAround(false);
+    desktops->setCurrent(2);
+    QSignalSpy previousTaskSpy(m_previousTask, &QAction::triggered);
+    QSignalSpy nextTaskSpy(m_nextTask, &QAction::triggered);
+    QSignalSpy changingSpy(desktops, &VirtualDesktopManager::currentChanging);
+    input()->pointer()->processSwipeGestureBegin(fingers, std::chrono::milliseconds(1));
+    // Stock realtime shortcuts queue cancellation callbacks when direction locks.
+    // Drain that first input frame before delivering further progress/release.
+    input()->pointer()->processSwipeGestureUpdate(delta / 24, std::chrono::milliseconds(2));
+    QCoreApplication::processEvents();
+    input()->pointer()->processSwipeGestureUpdate(delta - delta / 24, std::chrono::milliseconds(3));
+    QVERIFY(!changingSpy.isEmpty());
+    input()->pointer()->processSwipeGestureEnd(std::chrono::milliseconds(4));
+    QTRY_COMPARE(desktops->current(), desktop);
+    QTest::qWait(50);
+    QCOMPARE(desktops->current(), desktop);
+    QCOMPARE(previousTaskSpy.count(), 0);
+    QCOMPARE(nextTaskSpy.count(), 0);
 }
 
