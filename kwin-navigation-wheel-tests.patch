+void GlobalShortcutsTest::testNavigationWheel()
+{
+    auto desktops = VirtualDesktopManager::self();
+    desktops->setCount(3);
+    desktops->setNavigationWrappingAround(false);
+    desktops->setCurrent(1);
+
+    QVERIFY(Test::waitForWaylandPointer());
+    std::unique_ptr<KWayland::Client::Pointer> pointer(Test::waylandSeat()->createPointer());
+    QSignalSpy enteredSpy(pointer.get(), &KWayland::Client::Pointer::entered);
+    QSignalSpy axisSpy(pointer.get(), &KWayland::Client::Pointer::axisChanged);
+    std::unique_ptr<KWayland::Client::Surface> surface(Test::createSurface());
+    std::unique_ptr<Test::XdgToplevel> shellSurface(Test::createXdgToplevelSurface(surface.get()));
+    auto window = Test::renderAndWaitForShown(surface.get(), QSize(100, 50), Qt::blue);
+    QVERIFY(window);
+    input()->pointer()->warp(window->frameGeometry().center());
+    QTRY_COMPARE(enteredSpy.count(), 1);
+
+    quint32 timestamp = 1;
+    // Fractional deltas and horizontal scrolling must reach the client intact.
+    Test::pointerAxisVertical(7.5, timestamp++);
+    QTRY_COMPARE(axisSpy.count(), 1);
+    QCOMPARE(axisSpy.last().at(2).toReal(), 7.5);
+    Test::pointerAxisVertical(-2.5, timestamp++);
+    QTRY_COMPARE(axisSpy.count(), 2);
+    QCOMPARE(axisSpy.last().at(2).toReal(), -2.5);
+    Test::pointerAxisHorizontal(3.25, timestamp++);
+    QTRY_COMPARE(axisSpy.count(), 3);
+    QCOMPARE(axisSpy.last().at(2).toReal(), 3.25);
+
+    Test::keyboardKeyPressed(KEY_LEFTMETA, timestamp++);
+    Test::pointerAxisVertical(15, timestamp++);
+    QTRY_COMPARE(desktops->currentDesktop()->x11DesktopNumber(), 2u);
+    Test::pointerAxisVertical(15, timestamp++);
+    QTRY_COMPARE(desktops->currentDesktop()->x11DesktopNumber(), 3u);
+    Test::pointerAxisVertical(15, timestamp++);
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(desktops->currentDesktop()->x11DesktopNumber(), 3u);
+    Test::pointerAxisVertical(-15, timestamp++);
+    QTRY_COMPARE(desktops->currentDesktop()->x11DesktopNumber(), 2u);
+    Test::pointerAxisVertical(-15, timestamp++);
+    QTRY_COMPARE(desktops->currentDesktop()->x11DesktopNumber(), 1u);
+    Test::pointerAxisVertical(-15, timestamp++);
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(desktops->currentDesktop()->x11DesktopNumber(), 1u);
+    QCOMPARE(axisSpy.count(), 3);
+
+    // Adding Shift reserves the wheel for taskbar navigation, not desktops.
+    QSignalSpy previousTaskSpy(m_previousTask, &QAction::triggered);
+    QSignalSpy nextTaskSpy(m_nextTask, &QAction::triggered);
+    Test::keyboardKeyPressed(KEY_LEFTSHIFT, timestamp++);
+    Test::pointerAxisVertical(15, timestamp++);
+    Test::pointerAxisVertical(-15, timestamp++);
+    QTRY_COMPARE(nextTaskSpy.count(), 1);
+    QTRY_COMPARE(previousTaskSpy.count(), 1);
+    QVERIFY(Test::waylandSync());
+    QCOMPARE(desktops->currentDesktop()->x11DesktopNumber(), 1u);
+    QCOMPARE(axisSpy.count(), 3);
+    Test::keyboardKeyReleased(KEY_LEFTMETA, timestamp++);
+
+    // Shift on its own must not leave the wheel captured.
+    Test::pointerAxisVertical(-7.5, timestamp++);
+    QTRY_COMPARE(axisSpy.count(), 4);
+    QCOMPARE(axisSpy.last().at(2).toReal(), -7.5);
+    Test::keyboardKeyReleased(KEY_LEFTSHIFT, timestamp++);
+    Test::pointerAxisVertical(2.5, timestamp++);
+    QTRY_COMPARE(axisSpy.count(), 5);
+    QCOMPARE(axisSpy.last().at(2).toReal(), 2.5);
+
+    shellSurface.reset();
+    surface.reset();
+    QVERIFY(Test::waitForWindowClosed(window));
+    desktops->setCount(1);
+}
