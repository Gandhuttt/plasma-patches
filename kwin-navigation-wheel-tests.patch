+void GlobalShortcutsTest::testNavigationGestures_data()
+{
+    QTest::addColumn<QPointF>("delta");
+    QTest::addColumn<int>("fingers");
+    QTest::addColumn<bool>("cancel");
+    QTest::addColumn<uint>("desktop");
+    QTest::addColumn<int>("previousTasks");
+    QTest::addColumn<int>("nextTasks");
+
+    struct Direction {
+        const char *name;
+        QPointF delta;
+        uint desktop;
+        int previousTasks;
+        int nextTasks;
+    };
+    const Direction directions[] = {
+        {"left", QPointF(-600, 0), 3, 1, 0},
+        {"right", QPointF(600, 0), 3, 0, 1},
+        {"up", QPointF(0, -600), 2, 0, 0},
+        {"down", QPointF(0, 600), 4, 0, 0},
+    };
+    for (const auto &direction : directions) {
+        QTest::newRow(direction.name) << direction.delta << 3 << false << direction.desktop << direction.previousTasks << direction.nextTasks;
+        QTest::newRow(qPrintable(QStringLiteral("%1-cancel").arg(direction.name))) << direction.delta << 3 << true << 3u << 0 << 0;
+        QTest::newRow(qPrintable(QStringLiteral("%1-short").arg(direction.name))) << direction.delta / 12 << 3 << false << 3u << 0 << 0;
+        QTest::newRow(qPrintable(QStringLiteral("%1-below-threshold").arg(direction.name))) << direction.delta * (199.0 / 600) << 3 << false << 3u << 0 << 0;
+        QTest::newRow(qPrintable(QStringLiteral("%1-at-threshold").arg(direction.name))) << direction.delta / 3 << 3 << false << direction.desktop << direction.previousTasks << direction.nextTasks;
+        QTest::newRow(qPrintable(QStringLiteral("%1-two-fingers").arg(direction.name))) << direction.delta << 2 << false << 3u << 0 << 0;
+        QTest::newRow(qPrintable(QStringLiteral("%1-five-fingers").arg(direction.name))) << direction.delta << 5 << false << 3u << 0 << 0;
+    }
+    QTest::newRow("no-motion") << QPointF() << 3 << false << 3u << 0 << 0;
+}
+
+void GlobalShortcutsTest::testNavigationGestures()
+{
+    if (!qEnvironmentVariableIntValue("KWIN_TEST_NAVIGATION_GESTURES")) {
+        QSKIP("NavigationGestures is not enabled in this process");
+    }
+    QFETCH(QPointF, delta);
+    QFETCH(int, fingers);
+    QFETCH(bool, cancel);
+    QFETCH(uint, desktop);
+    QFETCH(int, previousTasks);
+    QFETCH(int, nextTasks);
+
+    auto desktops = VirtualDesktopManager::self();
+    desktops->setCount(5);
+    desktops->setRows(1);
+    desktops->setCurrent(3);
+    desktops->setNavigationWrappingAround(true);
+    QSignalSpy previousTaskSpy(m_previousTask, &QAction::triggered);
+    QSignalSpy nextTaskSpy(m_nextTask, &QAction::triggered);
+    QSignalSpy changingSpy(desktops, &VirtualDesktopManager::currentChanging);
+
+    auto pointer = input()->pointer();
+    pointer->processSwipeGestureBegin(fingers, std::chrono::milliseconds(1));
+    // Several times the threshold must still commit just once, on release.
+    pointer->processSwipeGestureUpdate(delta / 2, std::chrono::milliseconds(2));
+    QCoreApplication::processEvents();
+    pointer->processSwipeGestureUpdate(delta / 2, std::chrono::milliseconds(3));
+    QCoreApplication::processEvents();
+    QCOMPARE(desktops->current(), 3u);
+    QCOMPARE(previousTaskSpy.count(), 0);
+    QCOMPARE(nextTaskSpy.count(), 0);
+    QCOMPARE(changingSpy.count(), 0); // No competing stock desktop animation.
+    if (cancel) {
+        pointer->processSwipeGestureCancelled(std::chrono::milliseconds(4));
+    } else {
+        pointer->processSwipeGestureEnd(std::chrono::milliseconds(4));
+    }
+    QTRY_COMPARE(desktops->current(), desktop);
+    QTRY_COMPARE(previousTaskSpy.count(), previousTasks);
+    QTRY_COMPARE(nextTaskSpy.count(), nextTasks);
+    // Also allow queued actions and the D-Bus round trip to expose duplicates or
+    // unwanted cancellation callbacks in cases with no expected action.
+    QTest::qWait(50);
+    QCOMPARE(desktops->current(), desktop);
+    QCOMPARE(previousTaskSpy.count(), previousTasks);
+    QCOMPARE(nextTaskSpy.count(), nextTasks);
+    QCOMPARE(changingSpy.count(), 0);
+}
+
+void GlobalShortcutsTest::testNavigationGestureBoundaries()
+{
+    if (!qEnvironmentVariableIntValue("KWIN_TEST_NAVIGATION_GESTURES")) {
+        QSKIP("NavigationGestures is not enabled in this process");
+    }
+    auto desktops = VirtualDesktopManager::self();
+    desktops->setCount(3);
+    desktops->setRows(1);
+    // Navigation gestures never wrap, even if keyboard/default gestures may.
+    desktops->setNavigationWrappingAround(true);
+    QSignalSpy previousTaskSpy(m_previousTask, &QAction::triggered);
+    QSignalSpy nextTaskSpy(m_nextTask, &QAction::triggered);
+    for (const auto &[desktop, delta] : {std::pair(1u, QPointF(0, -600)), std::pair(3u, QPointF(0, 600))}) {
+        desktops->setCurrent(desktop);
+        QSignalSpy changedSpy(desktops, &VirtualDesktopManager::currentChanged);
+        input()->pointer()->processSwipeGestureBegin(3, std::chrono::milliseconds(1));
+        input()->pointer()->processSwipeGestureUpdate(delta, std::chrono::milliseconds(2));
+        input()->pointer()->processSwipeGestureEnd(std::chrono::milliseconds(3));
+        QTest::qWait(50);
+        QCOMPARE(desktops->current(), desktop);
+        QCOMPARE(changedSpy.count(), 0);
+    }
+    QCOMPARE(previousTaskSpy.count(), 0);
+    QCOMPARE(nextTaskSpy.count(), 0);
+}
